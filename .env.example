# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insighthub?schema=public"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Authentication (NextAuth - alternative)
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# Firecrawl
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InsightHub"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# Optional: Email (for digests)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@insighthub.ai"

# Optional: Redis (for caching & rate limiting)
REDIS_URL="redis://localhost:6379"

# Optional: Sentry (for error tracking)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
