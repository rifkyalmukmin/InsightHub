# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insighthub?schema=public"

# Authentication (NextAuth)
# REQUIRED — generate a real value, e.g. `openssl rand -base64 32`.
# The placeholder below is intentionally REJECTED at startup (see lib/utils/env.ts),
# so copying .env.example verbatim fails fast instead of running with a known secret.
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# Firecrawl
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InsightHub"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
# Per-user budget for authenticated requests (keyed by account, not IP) so
# users behind a shared NAT never exhaust each other's bucket.
RATE_LIMIT_USER_MAX_REQUESTS="300"
RATE_LIMIT_USER_WINDOW_MS="60000"
# Cap for anonymous requests when the client IP cannot be determined
# ('unknown' on a bare server without proxy headers) — one client must not
# exhaust the shared bucket for everyone else.
RATE_LIMIT_UNKNOWN_IP_MAX_REQUESTS="30"
# Trust X-Forwarded-For / X-Real-IP from a reverse proxy (Vercel, Cloudflare,
# nginx/Caddy). Leave empty on a bare server — client-supplied XFF is
# spoofable and must not be trusted for rate limiting. Set to "true" when the
# app runs behind a proxy that strips/replaces client-supplied headers.
TRUST_PROXY=""

# Daily usage quotas (paid API cost control). 0 = unlimited for that type.
USAGE_DAILY_LIMIT_SUMMARIZE="20"
USAGE_DAILY_LIMIT_CRAWL="5"
USAGE_DAILY_LIMIT_CHAT="100"
USAGE_DAILY_LIMIT_DIGEST="10"
# Hard stop on total paid calls per day across all users (0 = disabled)
USAGE_GLOBAL_DAILY_BUDGET="0"
# Log a warning when a user reaches this fraction of their daily limit
USAGE_ALERT_THRESHOLD="0.8"
# How many days of usage history to keep
USAGE_RETENTION_DAYS="7"

# ─── Not yet implemented (reserved for future use) ───
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@insighthub.ai"
# REDIS_URL="redis://localhost:6379"
